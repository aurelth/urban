# Servidor web do frontend do Urban (Angular SPA).
#
# Este arquivo e um TEMPLATE: ao iniciar, a imagem oficial do nginx substitui as variaveis
# ${...} abaixo pelas variaveis de ambiente do container e grava o resultado em
# /etc/nginx/conf.d/default.conf. As variaveis do proprio nginx ($host, $uri...) nao sao tocadas.
#
#   API_UPSTREAM  endereco do Gateway (ex.: http://gateway:8080)
#   DNS_RESOLVER  DNS usado para resolver o nome acima (Docker: 127.0.0.11)

# WebSocket (SignalR): mantem o "Upgrade" so quando o cliente pediu.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # Somente IPv4: hosts Docker sem IPv6 derrubariam o nginx na partida com "listen [::]".
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Resolve o Gateway em tempo de requisicao (e nao so na partida). Sem isto, o nginx
    # nao sobe se o Gateway ainda nao existir na rede.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

    # Cabecalhos de seguranca. Importante: nao use "add_header" dentro dos "location" abaixo,
    # porque isso faz o nginx descartar os cabecalhos definidos aqui.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Verificacao de saude do container (nao passa pelo Gateway).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API REST -> Gateway.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SignalR (WebSocket) -> Gateway. Conexoes longas, sem buffer.
    location /hubs/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # index.html nunca fica em cache: e ele que aponta para os arquivos com hash da versao atual.
    location = /index.html {
        expires -1;
    }

    # Arquivos do build com hash no nome (ex.: main-G66TAGKO.js) mudam a cada versao,
    # entao podem ficar em cache por 1 ano.
    location ~ "^/[^/]+-[A-Za-z0-9]{8}\.(?:js|css)$" {
        expires 1y;
        try_files $uri =404;
    }

    # Demais arquivos estaticos (icones, favicon) e rotas do Angular.
    # Qualquer caminho que nao seja arquivo cai no index.html (roteamento do lado do cliente).
    location / {
        expires 1h;
        try_files $uri $uri/ /index.html;
    }
}
