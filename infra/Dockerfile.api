# syntax=docker/dockerfile:1.7

# Imagem da API do Urban (ASP.NET Core / .NET 10).
# Contexto de build: a RAIZ do repositorio.
#   docker build -f infra/Dockerfile.api -t urban-api:local .

# As tags das imagens ficam escritas direto no FROM de proposito: o Dependabot so le
# imagens literais (ele nao resolve ARG). Para trocar de versao, edite as duas linhas FROM.

# ---------------------------------------------------------------------------
# Estagio 1: build. Usa o SDK completo (grande); nada deste estagio vai para producao.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# 1) Arquivos de configuracao da solucao. Mudam raramente.
COPY global.json nuget.config Directory.Build.props Directory.Packages.props ./

# 2) So os .csproj, para o restore ficar numa camada propria. Enquanto nenhum .csproj
#    ou pacote mudar, o Docker reaproveita o restore em cache e so recompila o codigo.
COPY src/Urban.SharedKernel/Urban.SharedKernel.csproj src/Urban.SharedKernel/
COPY src/Urban.BackgroundJobs/Urban.BackgroundJobs.csproj src/Urban.BackgroundJobs/
COPY src/Urban.EmailDelivery/Urban.EmailDelivery.csproj src/Urban.EmailDelivery/
COPY src/Modules/Identity/Urban.Identity.Domain/Urban.Identity.Domain.csproj src/Modules/Identity/Urban.Identity.Domain/
COPY src/Modules/Identity/Urban.Identity.Application/Urban.Identity.Application.csproj src/Modules/Identity/Urban.Identity.Application/
COPY src/Modules/Identity/Urban.Identity.Infrastructure/Urban.Identity.Infrastructure.csproj src/Modules/Identity/Urban.Identity.Infrastructure/
COPY src/Modules/Condominium/Urban.Condominium.Domain/Urban.Condominium.Domain.csproj src/Modules/Condominium/Urban.Condominium.Domain/
COPY src/Modules/Condominium/Urban.Condominium.Application/Urban.Condominium.Application.csproj src/Modules/Condominium/Urban.Condominium.Application/
COPY src/Modules/Condominium/Urban.Condominium.Infrastructure/Urban.Condominium.Infrastructure.csproj src/Modules/Condominium/Urban.Condominium.Infrastructure/
COPY src/Modules/Finance/Urban.Finance.Domain/Urban.Finance.Domain.csproj src/Modules/Finance/Urban.Finance.Domain/
COPY src/Modules/Finance/Urban.Finance.Application/Urban.Finance.Application.csproj src/Modules/Finance/Urban.Finance.Application/
COPY src/Modules/Finance/Urban.Finance.Infrastructure/Urban.Finance.Infrastructure.csproj src/Modules/Finance/Urban.Finance.Infrastructure/
COPY src/Modules/Operations/Urban.Operations.Domain/Urban.Operations.Domain.csproj src/Modules/Operations/Urban.Operations.Domain/
COPY src/Modules/Operations/Urban.Operations.Application/Urban.Operations.Application.csproj src/Modules/Operations/Urban.Operations.Application/
COPY src/Modules/Operations/Urban.Operations.Infrastructure/Urban.Operations.Infrastructure.csproj src/Modules/Operations/Urban.Operations.Infrastructure/
COPY src/Urban.Api/Urban.Api.csproj src/Urban.Api/
RUN dotnet restore src/Urban.Api/Urban.Api.csproj

# 3) Codigo-fonte (so o que a API precisa) e publicacao.
COPY .editorconfig ./
COPY src/Urban.SharedKernel/ src/Urban.SharedKernel/
COPY src/Urban.BackgroundJobs/ src/Urban.BackgroundJobs/
COPY src/Urban.EmailDelivery/ src/Urban.EmailDelivery/
COPY src/Modules/ src/Modules/
COPY src/Urban.Api/ src/Urban.Api/

# VERSION vem do pipeline (ex.: 1.4.2). Local, fica 0.0.0.
ARG VERSION=0.0.0
RUN dotnet publish src/Urban.Api/Urban.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    -p:Version=${VERSION} \
    -p:UseAppHost=false

# ---------------------------------------------------------------------------
# Estagio 2: imagem final. Runtime ASP.NET "chiseled" (Ubuntu minimo, sem shell, sem
# gerenciador de pacotes, usuario nao-root). O sufixo "-extra" inclui ICU e tzdata,
# necessarios para cultura pt-BR (moeda, datas) e fusos horarios.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra AS final
WORKDIR /app
COPY --from=build /app/publish .

# Porta 8080 (as portas < 1024 exigem root). A porta publicada ao mundo fica no compose/proxy.
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

# Nao roda como root: a imagem define o usuario "app" (UID 1654).
USER $APP_UID

ENTRYPOINT ["dotnet", "Urban.Api.dll"]

