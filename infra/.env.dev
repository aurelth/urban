# Urban - variáveis da infraestrutura local (SOMENTE DESENVOLVIMENTO)
# Copie para infra/.env (que o git ignora). Nunca coloque segredos reais aqui:
# este repositório é público. Produção usa segredos do GitHub/VPS.

# PostgreSQL
POSTGRES_DB=urban
POSTGRES_USER=urban
POSTGRES_PASSWORD=urban_dev_password
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=urban_dev_password
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=urban
RABBITMQ_PASSWORD=urban_dev_password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# Garage (armazenamento S3)
# rpc_secret: 64 caracteres hexadecimais
GARAGE_RPC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
GARAGE_ADMIN_TOKEN=urban_dev_admin_token
GARAGE_METRICS_TOKEN=urban_dev_metrics_token
# Chave de acesso: "GK" + 24 hex | segredo: 64 hex
GARAGE_DEFAULT_ACCESS_KEY=GK0123456789abcdef01234567
GARAGE_DEFAULT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_DEFAULT_BUCKET=urban-files
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
